<odoo>
    <record id="view_stock_quant_simple_secondary" model="ir.ui.view">
        <field name="name">stock.quant.simple.secondary</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <!-- Inserir depois do campo available_quantity -->
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="x_secondary_qty" string="Qtà Secondaria"/>
                <field name="x_secondary_uom_id" string="U.M. Secondaria"/>
            </xpath>
        </field>
    </record>
</odoo>
