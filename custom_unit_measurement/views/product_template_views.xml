<odoo>
    <record id="view_product_form_secondary_uom" model="ir.ui.view">
        <field name="name">product.template.form.secondary.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Insere o campo depois do bloco que contém "per KG" -->
            <xpath expr="//div[@name='list_price_uom']" position="after">
                    <field name="x_secondary_uom_id" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//button[@name='action_open_documents']" position="before">
                <button type="object"
                        name="action_dummy_secondary_qty"
                        icon="fa-cubes"
                        class="oe_stat_button"
                        invisible="x_secondary_uom_id == False">
                    <field name="x_secondary_qty_display" widget="statinfo" string="Quantità secondaria disponibile"/>

                </button>
            </xpath>
        </field>
    </record>
</odoo>
