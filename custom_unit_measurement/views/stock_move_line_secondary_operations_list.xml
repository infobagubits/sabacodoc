<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_secondary_in_operations_list" model="ir.ui.view">
        <field name="name">stock.move.line.secondary.in.operations.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id'][last()]" position="after">
                <field name="x_secondary_qty"/>
                <field name="x_secondary_uom_id"/>
            </xpath>
        </field>
    </record>
</odoo>