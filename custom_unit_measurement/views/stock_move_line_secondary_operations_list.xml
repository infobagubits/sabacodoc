<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_secondary_in_operations_list" model="ir.ui.view">
        <field name="name">stock.move.line.secondary.in.operations.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            
            <!-- Rinominare Numero di Lotto/Serie in "Lotto" -->
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">Lotto</attribute>
            </xpath>
                    
            <!-- Rinominare Unità di misura in "UdM" -->
            <xpath expr="//field[@name='product_uom_id'][last()]" position="attributes">
                <attribute name="string">UdM</attribute>
            </xpath>
            
            <!-- Aggiungere campi secondari con nomi personalizzati -->
            <xpath expr="//field[@name='product_uom_id'][last()]" position="after">
                <field name="x_secondary_qty" string="Qty sec."/>
                <field name="x_secondary_uom_id" string="UdM sec"/>
            </xpath>
            
            <!-- Aggiungere campi packaging dopo quantity -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="product_packaging_qty" readonly="False"/>
                <field name="product_packaging_id" column_invisible="not move_id.product_packaging_id"/>
            </xpath>
        </field>
    </record>
</odoo>