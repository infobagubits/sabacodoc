<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- View específica para campos que não aparecem -->
        <record id="view_partner_form_fields_extension" model="ir.ui.view">
            <field name="name">res.partner.form.fields.extension</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <!-- Adicionar campos no primeiro grupo da sheet -->
                <xpath expr="//sheet/group/group[1]" position="inside">
                    <field name="contact_method_ids" widget="many2many_tags"
                        invisible="not is_customer" />
                    <field name="note_consegna" invisible="not is_customer" />
                    <field name="note_amministrative" invisible="not is_customer" />
                    <field name="note_passaggi" invisible="not is_customer" />
                    <field name="listini_consegnati" invisible="not is_customer" />
                </xpath>
                
                <!-- Adicionar etiquetas para telefone e celular no segundo grupo -->
                <xpath expr="//sheet/group/group[2]" position="inside">
                    <field name="etichetta_telefono" />
                    <field name="etichetta_cellulare" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
