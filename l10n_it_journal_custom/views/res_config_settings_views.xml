<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pagination" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pagination</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Report Italiani - Numerazione Pagine" id="italian_reports_pagination">
                    <setting string="Numerazione Avanzata Pagine" help="Configura la numerazione personalizzata delle pagine per i report contabili italiani">
                        <field name="page_offset_enabled"/>
                        <div class="content-group" invisible="not page_offset_enabled">
                            <div class="row mt16">
                                <label for="page_offset" class="col-lg-3 o_light_label">
                                    Numero Pagina Iniziale:
                                </label>
                                <field name="page_offset" class="col-lg-3"/>
                            </div>
                            <div class="text-muted mt8">
                                <small>Esempio: Inserire 12 per far iniziare la numerazione dalla pagina 12 invece che dalla 1</small>
                            </div>
                            <div class="text-info mt8">
                                <small><i class="fa fa-info-circle"/> Questa impostazione si applica automaticamente ai report "Registri IVA" e "Fatture Fornitore"</small>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo> 