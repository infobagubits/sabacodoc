<odoo>
    <record id="res_partner_search_inherit_customer_supplier" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.customer.supplier</field>
        <field name="model">res.partner</field>
        <!-- Herdando a search view base (ID=128) -->
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <!-- Ajuste a prioridade se precisar que seja aplicada depois de outras heranças -->
        <!-- <field name="priority">99</field> -->
        <field name="arch" type="xml">

            <!-- Inserir DEPOIS do filtro name="inactive" -->
            <xpath expr="//filter[@name='inactive']" position="after">

                <filter
                    name="filter_is_customer"
                    string="E' un cliente"
                    domain="[('is_customer','=', True)]"
                />
                <filter
                    name="filter_is_supplier"
                    string="E' un fornitore"
                    domain="[('is_supplier','=', True)]"
                />

            </xpath>
        </field>
    </record>
</odoo>