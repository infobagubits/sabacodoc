<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='stock_packaging_purchase']" position="after">
                <setting id="purchase_product_filter_setting" 
                        title="Permette di filtrare i prodotti in base al fornitore selezionato"
                        help="Quando attivato, verranno mostrati solo i prodotti collegati al fornitore nelle righe dell'ordine di acquisto">
                    <field name="purchase_product_filter"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo> 