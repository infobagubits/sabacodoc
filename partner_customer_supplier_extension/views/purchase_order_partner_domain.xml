<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista per la riga dell'ordine -->
    <record id="purchase_order_line_tree_view_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="replace">
                <field name="contact_partner_id" string="Contatto" domain="[('is_supplier', '=', True)]"/>
            </field>
        </field>
    </record>

    <!-- Vista principale dell'ordine di acquisto -->
    <record id="purchase_order_form_inherit_supplier_filter" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.supplier.filter</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_supplier', '=', True)]</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="context">{'partner_id': parent.partner_id}</attribute>
                <attribute name="domain">[('id', 'in', parent.available_product_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
