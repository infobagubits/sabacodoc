<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         Imposta di acquisto: aggiungiamo i campi "Imposta originale (-)" e
         "Imposta differita (+)", da configurare sulla tassa IVA DIFFERITA
         stessa (es. "IVA differita 22%"):
         - Imposta originale (-): quale tassa originale (es. "IVA 22%")
           questa sostituisce in fattura (usata per il Dare dello storno).
         - Imposta differita (+): tassa da usare, al posto di questa, sulla
           riga Avere dell'imponibile dello storno.
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_tax_form_iva_differita" model="ir.ui.view">
        <field name="name">account.tax.form.iva.differita</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="after">
                <field
                    name="iva_differita_tax_id"
                    invisible="type_tax_use != 'purchase'"
                />
                <field
                    name="iva_differita_tax_plus_id"
                    invisible="type_tax_use != 'purchase'"
                />
            </xpath>
        </field>
    </record>

</odoo>
