<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="view_picking_form_supplier_document" model="ir.ui.view">
            <field name="name">stock.picking.form.documento.fornitore</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Banner di avviso per documento fornitore duplicato -->
                <xpath expr="//header" position="after">
                    <field name="duplicate_supplier_document_warning" invisible="1"/>
                    <div class="alert alert-warning text-center" role="alert" 
                         invisible="not duplicate_supplier_document_warning">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <field name="duplicate_supplier_document_warning" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                </xpath>
                
                <!-- Campi documento fornitore -->
                <xpath expr="//field[@name='picking_type_id']" position="after">
                    <field name="is_reso_picking" invisible="1"/>
                    <field name="supplier_document_number" 
                           invisible="picking_type_code != 'incoming' or is_reso_picking" 
                           readonly="state in ['cancel', 'done']"/>
                    <field name="supplier_document_date" 
                           invisible="picking_type_code != 'incoming' or is_reso_picking" 
                           readonly="state in ['cancel', 'done']"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo> 