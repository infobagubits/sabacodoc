<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_xml_total_mismatch_warning" model="ir.ui.view">
        <field name="name">account.move.form.xml.total.mismatch.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <field name="xml_total_mismatch_warning" invisible="1"/>
                <div class="alert alert-warning w-100 d-flex align-items-center gap-1"
                     invisible="not xml_total_mismatch_warning"
                     role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <field name="xml_total_mismatch_warning" readonly="1" nolabel="1" class="d-inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
