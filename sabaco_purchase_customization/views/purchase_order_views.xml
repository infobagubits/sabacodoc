<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Inherits the purchase order view -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.sabaco.customization</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']"
                position="after">
                <field name="purchase_order_for" readonly="state in ['done','cancelled']" />
            </xpath>
        </field>
    </record>
</odoo>