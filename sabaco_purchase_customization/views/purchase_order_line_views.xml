<odoo>
    <!-- Eredita la vista tree standard -->
    <record id="purchase_order_line_tree_view_inherit_uom" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit.uom</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <!-- Modifica solo l\'ordine dei campi che esistono realmente nella tree principale -->
            <xpath expr="//field[@name='product_qty']" position="replace">
                <field name="product_qty" />
                <field name="purchase_uom_free" string="UdM acquisto libera" />
                <field name="product_uom" string="UdM fattura" readonly="1" />
            </xpath>
        </field>
    </record>

    <!-- Eredita il form dell\'ordine di acquisto per modificare la tree inline, con modifica
    completa -->
    <record id="purchase_order_form_view_inherit_uom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.uom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Rimuove i campi dalla posizione originale -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']"
                position="replace" />
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']"
                position="replace" />
            <!-- Aggiunge i campi prima di product_qty -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                position="before">
                <field name="product_packaging_id" invisible="not product_id"
                    context="{'default_product_id': product_id, 'list_view_ref':'product.product_packaging_tree_view', 'form_view_ref':'product.product_packaging_form_view'}"
                    groups="product.group_stock_packaging" />
                <field name="product_packaging_qty"
                    invisible="not product_id or not product_packaging_id"
                    groups="product.group_stock_packaging" />
            </xpath>
            <!-- Sostituisce il blocco delle UoM -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                position="after">
                <field name="purchase_uom_free" string="UdM acquisto libera" />
                <field name="product_uom" string="UdM fattura" readonly="1" />
            </xpath>
        </field>
    </record>

    <!-- Eredita il form dell\'ordine di acquisto per nascondere i campi -->
    <record id="purchase_order_form_view_inherit_hide_fields" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.hide.fields</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Nasconde il campo partner_ref -->
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Nasconde il campo date_order -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Nasconde il div reminder -->
            <xpath expr="//div[@name='reminder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- Eredita la vista dello storico acquisti per aggiungere i nuovi campi -->
    <record id="purchase_history_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.history.tree.inherit</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_history_tree"/>
        <field name="arch" type="xml">
            <!-- Aggiunge i campi qt. a disposizione e qt. prevista dopo quantity -->
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="qty_available_at_confirmation" string="Qt. a disposizione"/>
                <field name="qty_planned_at_confirmation" string="Qt. prevista"/>
            </xpath>
            
            <!-- Aggiunge campo giorno della settimana dopo date_approve -->
            <xpath expr="//field[@name='date_approve']" position="after">
                <field name="confirmation_weekday" string="Giorno"/>
            </xpath>
        </field>
    </record>
    
    <!-- Eredita la vista di ricerca dello storico per aggiungere il filtro per giorno settimana -->
    <record id="purchase_order_line_search_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.search.inherit</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
        <field name="arch" type="xml">
            <!-- Aggiunge filtri per giorno della settimana -->
            <xpath expr="//separator[1]" position="before">
                <filter string="Lunedì" name="filter_monday" domain="[('confirmation_weekday', '=', 'Lunedì')]"/>
                <filter string="Martedì" name="filter_tuesday" domain="[('confirmation_weekday', '=', 'Martedì')]"/>
                <filter string="Mercoledì" name="filter_wednesday" domain="[('confirmation_weekday', '=', 'Mercoledì')]"/>
                <filter string="Giovedì" name="filter_thursday" domain="[('confirmation_weekday', '=', 'Giovedì')]"/>
                <filter string="Venerdì" name="filter_friday" domain="[('confirmation_weekday', '=', 'Venerdì')]"/>
                <filter string="Sabato" name="filter_saturday" domain="[('confirmation_weekday', '=', 'Sabato')]"/>
                <filter string="Domenica" name="filter_sunday" domain="[('confirmation_weekday', '=', 'Domenica')]"/>
            </xpath>
        </field>
    </record>
</odoo>