<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="address_layout_custom"
        inherit_id="web.address_layout">
        <!--
            MELHORIA-011 — Guardia contro il doppio blocco indirizzo nel DDT.
            web.address_layout viene chiamato DUE volte: nell'intestazione
            (external_layout_bubble.xml, chiamata aggiunta da noi) e nel corpo del
            layout bubble del core, che è l'unico dei due a impostare
            custom_layout_address=True.
            Il DDT e la fattura alzano sabaco_address_header_only e vogliono il
            blocco solo nell'intestazione: la copia nel corpo resta nel DOM con
            classe Bootstrap invisible (visibility:hidden) per non far salire
            titolo e contenuto sottostante.
            Fuori da DDT e fattura è inerte — sabaco_address_header_only non è
            definita e QWeb tratta un nome non definito come falsy, quindi
            ordini e altri report restano identici a prima.
        -->
        <xpath position="replace" expr="//div[@t-if='address']">
            <div t-if="address"
                t-attf-class="address row mb-4#{' invisible' if custom_layout_address and sabaco_address_header_only else ''}"
                style="font-size: 12px"
                title="This block is not always present depending on the printed document.">
                <div>
                    <strong class="d-block">Spett.le</strong>
                    <div name="address">
                        <t t-esc="address or None">
                            <div
                                class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 opacity-75 text-muted text-center">
                                <strong>Address block</strong>
                                <div>Usually contains the address of the document's recipient.</div>
                            </div>
                        </t>
                    </div>
                    <t t-if="information_block">
                        <div name="information_block" class="mt-2">
                            <t t-out="information_block or None">
                                <div
                                    class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 opacity-75 text-muted text-center">
                                    <strong>Information block</strong>
                                    <div>Usually contains a source address or a complementary
                                        address.</div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>