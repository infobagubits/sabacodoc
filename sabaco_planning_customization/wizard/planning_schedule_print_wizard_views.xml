<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_schedule_print_wizard_view_form" model="ir.ui.view">
        <field name="name">planning.schedule.print.wizard.form</field>
        <field name="model">planning.schedule.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Stampa programma per ruolo">
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Stampa PDF" class="btn-primary" data-hotkey="q"/>
                    <button string="Annulla" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_planning_schedule_print_wizard" model="ir.actions.act_window">
        <field name="name">Stampa programma per ruolo</field>
        <field name="res_model">planning.schedule.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="planning.model_planning_slot"/>
        <field name="binding_type">action</field>
    </record>
</odoo>
