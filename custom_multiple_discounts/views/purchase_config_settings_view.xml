<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_purchase_multiple_discounts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.multiple.discounts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='purchase_invoicing_settings']" position="after">
                <h2>Multiple Discounts for Purchase</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_multiple_discounts_purchase" 
                                   string="Enable Multiple Discounts for Purchase"
                                   force_save="1"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_multiple_discounts_purchase" class="o_form_label"/>
                            <div class="text-muted">
                                Allows applying two or three additional discounts on purchase order lines.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_setting_box" invisible="not enable_multiple_discounts_purchase">
                    <div class="o_setting_right_pane" >
                        <div class="o_setting_box" invisible="not enable_multiple_discounts_purchase">
                            <div style="width:100%;"> 
                                <field name="enable_multiple_discounts_purchase_qtd" options="{'line_breaks': False}" widget="radio" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

