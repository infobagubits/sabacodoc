<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_purchase_multiple_discounts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.multiple.discounts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Multiple Discounts">
                    <setting>
                        <field name="enable_multiple_discounts_purchase"/>
                        <div class="text-muted">
                            Allows applying two or three additional discounts on purchase order lines.
                        </div>
                    </setting>
                    <setting invisible="not enable_multiple_discounts_purchase">
                        <field name="enable_multiple_discounts_purchase_qtd" class="o_light_label" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
