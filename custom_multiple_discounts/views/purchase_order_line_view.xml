<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_multiple_discounts" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.multiple.discounts</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Injects the context -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">
                    {'hide_discount_purchase': show_multiple_discounts_purchase, 'show_discount3_purchase': show_discount3_purchase, 'default_state': 'draft'}
                </attribute>
            </xpath>

            <!-- Substitui o campo discount padrão - USA LIST NÃO TREE -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="replace">
                <field name="discount"
                    string="Disc.%"
                    width="50px"
                    readonly="qty_invoiced != 0"
                    column_invisible="context.get('hide_discount_purchase', False)"
                    optional="hide"/>
            </xpath>

            <!-- Additional fields -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="after">
                <field name="discount1"
                       string="Sc. 1%"
                       width="50px"
                       column_invisible="not context.get('hide_discount_purchase', False)"
                       optional="show"/>
                <field name="discount2"
                       string="Sc. 2%"
                       width="50px"
                       column_invisible="not context.get('hide_discount_purchase', False)"
                       optional="show"/>
                <field name="discount3"
                       string="Sc. 3%"
                       width="50px"
                       column_invisible="not context.get('hide_discount_purchase', False) or context.get('show_discount3_purchase', False)"
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
