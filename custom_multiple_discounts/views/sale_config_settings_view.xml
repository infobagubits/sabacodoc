<odoo>
    <record id="view_sale_config_settings_inherit" model="ir.ui.view">
        <field name="name">sale.config.settings.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='group_discount_per_so_line']" position="after">
                <div class="o_setting_box" invisible="not group_discount_per_so_line">
                    <div class="o_setting_left_pane">
                        <field name="enable_multiple_discounts"
                               string="Multiple Discounts"                               
                               force_save="1"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_multiple_discounts" class="o_form_label"/>
                        <div class="text-muted">
                            Allows applying two additional discounts on sale order lines.
                        </div>
                    </div>
                </div>
                <div class="o_setting_box" invisible="not enable_multiple_discounts">
                    <div class="o_setting_right_pane" >
                        <div class="o_setting_box" invisible="not enable_multiple_discounts">
                            <div style="width:100%;"> 
                                <field name="enable_multiple_discounts_qtd" options="{'line_breaks': False}" widget="radio" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
