<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_supplierinfo_list_inherit_multiple_discounts" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.inherit.multiple.discounts</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">

            <!-- Substitui o campo discount padrão -->
            <xpath expr="//field[@name='discount']" position="replace">
                <field name="discount"
                    string="Disc.%"
                    invisible="multiple_discounts_enabled"
                    column_invisible="context.get('hide_discount_purchase', False)"
                    optional="show"/>
            </xpath>

            <!-- Adiciona os novos campos após o campo discount -->
            <xpath expr="//field[@name='discount']" position="after">
                <field name="discount1"
                       string="Disc. 1 %"
                       invisible="not multiple_discounts_enabled"
                       column_invisible="not context.get('hide_discount_purchase', False)"
                       optional="show"/>
                <field name="discount2"
                       string="Disc. 2 %"
                       invisible="not multiple_discounts_enabled"
                       column_invisible="not context.get('hide_discount_purchase', False)"
                       optional="show"/>
                <field name="discount3"
                       string="Disc. 3 %"
                       invisible="not multiple_discounts_enabled or multiple_discounts_enabled_qtd"
                       column_invisible="not context.get('hide_discount_purchase', False) or context.get('show_discount3_purchase', False)"
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
