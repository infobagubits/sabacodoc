<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_supplierinfo_list_inherit_multiple_discounts" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.inherit.multiple.discounts</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">

            <!-- Adiciona campos computados invisíveis para controle de visibilidade -->
            <xpath expr="//field[@name='discount']" position="before">
                <field name="multiple_discounts_enabled" column_invisible="1"/>
                <field name="multiple_discounts_enabled_qtd" column_invisible="1"/>
            </xpath>

            <!-- Substitui o campo discount padrão -->
            <xpath expr="//field[@name='discount']" position="attributes">
                <attribute name="column_invisible">multiple_discounts_enabled</attribute>
            </xpath>

            <!-- Adiciona os novos campos após o campo discount -->
            <xpath expr="//field[@name='discount']" position="after">
                <field name="discount1"
                       string="Disc. 1 %"
                       column_invisible="not multiple_discounts_enabled"
                       optional="show"/>
                <field name="discount2"
                       string="Disc. 2 %"
                       column_invisible="not multiple_discounts_enabled"
                       optional="show"/>
                <field name="discount3"
                       string="Disc. 3 %"
                       column_invisible="not multiple_discounts_enabled or multiple_discounts_enabled_qtd"
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
