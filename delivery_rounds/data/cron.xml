<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ogni giorno: per i giri il cui giorno consegna è oggi o ieri, imposta tutte le righe a "Da chiamare" -->
        <record id="ir_cron_reset_giro_stato_da_chiamare" model="ir.cron">
            <field name="name">Giri Ordini: reset contatti a "Da chiamare" (giorno consegna / giorno dopo)</field>
            <field name="model_id" ref="delivery_rounds.model_giri_ordine"/>
            <field name="state">code</field>
            <field name="code">model._cron_reset_stato_da_chiamare()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
