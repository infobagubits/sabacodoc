<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_giro" model="ir.ui.view">
        <field name="name">sale.order.form.giro</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Inserimento dei campi prima del campo validity_date -->
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="giro_id" options="{'no_create': True}" placeholder="Seleziona un giro"/>
                <field name="sequenza_consegna"/>
            </xpath>

            <!-- Ordine creato dal giro: mostra Salva/Abbandona nel header vicino a Conferma -->
            <xpath expr="//form/header/button[@name='action_confirm'][1]" position="after">
                <button string="Salva"
                        special="save"
                        class="btn btn-secondary"
                        invisible="not giro_id or state in ('done','cancel')"/>
                <button string="Abbandona"
                        special="cancel"
                        class="btn btn-secondary"
                        invisible="not giro_id or state in ('done','cancel')"/>
            </xpath>

        </field>
    </record>
</odoo>