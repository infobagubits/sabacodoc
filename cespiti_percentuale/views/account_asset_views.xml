<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_asset_form_percentage" model="ir.ui.view">
        <field name="name">account.asset.form.percentage</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <!--
                Con il metodo 'percentage' la percentuale annua è il campo standard
                "Fattore decrescente" (method_progress_factor): resta visibile e obbligatorio.
            -->
            <!-- Form n.1 (modello / cespite): Fattore decrescente visibile; Durata e Calcolo nascosti con metodo 'percentage' -->
            <xpath expr="(//field[@name='method_progress_factor'])[1]" position="attributes">
                <attribute name="invisible">method == 'linear'</attribute>
                <attribute name="required">method in ('degressive', 'degressive_then_linear', 'percentage')</attribute>
            </xpath>
            <xpath expr="(//label[@for='method_number'])[1]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>
            <xpath expr="(//label[@for='method_number'])[1]/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='method_number'])[1]" position="attributes">
                <attribute name="required">method != 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='method_period'])[1]" position="attributes">
                <attribute name="required">method != 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='prorata_computation_type'])[1]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>

            <!-- Form n.2 (modello / cespite): Fattore decrescente visibile; Durata e Calcolo nascosti con metodo 'percentage' -->
            <xpath expr="(//field[@name='method_progress_factor'])[2]" position="attributes">
                <attribute name="invisible">method == 'linear'</attribute>
                <attribute name="required">method in ('degressive', 'degressive_then_linear', 'percentage')</attribute>
            </xpath>
            <xpath expr="(//label[@for='method_number'])[2]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>
            <xpath expr="(//label[@for='method_number'])[2]/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='method_number'])[2]" position="attributes">
                <attribute name="required">method != 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='method_period'])[2]" position="attributes">
                <attribute name="required">method != 'percentage'</attribute>
            </xpath>
            <xpath expr="(//field[@name='prorata_computation_type'])[2]" position="attributes">
                <attribute name="invisible">method == 'percentage'</attribute>
            </xpath>

            <!-- prorata_date: sempre visibile con metodo 'percentage'; altrimenti vale la condizione originale -->
            <xpath expr="//field[@name='prorata_date']" position="attributes">
                <attribute name="invisible">method != 'percentage' and prorata_computation_type == 'none'</attribute>
            </xpath>

        </field>
    </record>
</odoo>
