<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="account_accountant.BankRecRecordNotebookManualOperations" t-inherit-mode="extension">
        <xpath expr="//div[@name='analytic_distribution']" position="after">
            <t t-if="line.data.sabaco_differita_ammessa">
                <!-- deferred_start_date -->
                <div name="deferred_start_date" class="o_wrap_field d-flex d-sm-contents flex-column">
                    <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                        <label class="o_form_label" t-att-class="{'o_form_label_readonly': reconciled}">
                            Data inizio differita
                        </label>
                    </div>
                    <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 w-100">
                        <div class="o_field_widget o_field_date">
                            <DateTimeField name="'deferred_start_date'" record="line" readonly="reconciled"/>
                        </div>
                    </div>
                </div>
                <!-- deferred_end_date -->
                <div name="deferred_end_date" class="o_wrap_field d-flex d-sm-contents flex-column">
                    <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                        <label class="o_form_label" t-att-class="{'o_form_label_readonly': reconciled}">
                            Data fine differita
                        </label>
                    </div>
                    <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 w-100">
                        <div class="o_field_widget o_field_date">
                            <DateTimeField name="'deferred_end_date'" record="line" readonly="reconciled"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
