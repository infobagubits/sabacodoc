<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personalizzazione form prodotto per unità di misura secondaria -->
    <record id="modulo_personalizzato_vendite_product_template_form" model="ir.ui.view">
        <field name="name">modulo.personalizzato.vendite.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Inserisce il campo dopo il blocco che contiene "per KG" -->
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="x_secondary_uom_id" options="{'no_create': True}"/>
            </xpath>

            <!-- Aggiunge il pulsante di statistica prima del pulsante di documenti -->
            <xpath expr="//button[@name='action_open_documents']" position="before">
                <button type="object"
                        name="action_dummy_secondary_qty"
                        icon="fa-cubes"
                        class="oe_stat_button"
                        invisible="x_secondary_uom_id == False">
                    <field name="x_secondary_qty_display" widget="statinfo" string="Quantità secondaria disponibile"/>
                </button>
            </xpath>
            
        </field>
    </record>
</odoo>
