<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_zero_amount_warning" model="ir.ui.view">
        <field name="name">account.move.form.zero.amount.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Banner di avviso per prodotti con importo 0 (stesso stile di sale.order) -->
            <xpath expr="//header" position="after">
                <field name="zero_amount_line_warning" invisible="1"/>
                <div class="alert alert-warning text-center" role="alert"
                     invisible="not zero_amount_line_warning">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <field name="zero_amount_line_warning" readonly="1" nolabel="1" class="d-inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
