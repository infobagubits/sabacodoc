<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="modulo_personalizzato_vendite_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">modulo.personalizzato.vendite.stock.move.line.operation.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <!-- Inserire dopo il campo product_uom_id -->
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="x_secondary_qty"/>
                <field name="x_secondary_uom_id"/>
            </xpath>
        </field>
    </record>
</odoo>