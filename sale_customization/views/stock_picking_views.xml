<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="modulo_personalizzato_vendite_stock_picking_form" model="ir.ui.view">
        <!-- Nome interno della view -->
        <field name="name">modulo.personalizzato.vendite.stock.picking.form</field>
        <!-- Modello a cui si applica la view -->
        <field name="model">stock.picking</field>
        <!-- Eredita dalla view standard di stock.picking -->
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">

            <!-- Inietta il contesto nel campo one2many per definire hide_secondary e
            default_location_id -->
            <!--             <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="context">
                    {'hide_secondary': not has_secondary, 'default_location_id': location_id}
                </attribute>
            </xpath> -->

            <!-- Imposta la list view in modalità modificabile (bottom) -->
            <xpath expr="//field[@name='move_ids_without_package']/list" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>

        </field>
    </record>
</odoo>