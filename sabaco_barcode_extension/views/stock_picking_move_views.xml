<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Adiciona campo product_packaging_qty na lista de stock.move dentro do picking form -->
        <!-- Herda da view stock.picking.form onde está a lista move_ids_without_package -->
        <record id="view_picking_form_move_packaging_qty" model="ir.ui.view">
            <field name="name">stock.picking.form.move.packaging.qty</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Adiciona o campo product_packaging_qty após product_packaging_id na lista de move_ids_without_package -->
                <!-- FASE TESTE: Campo computado com valor fixo 5.00 para validar inserção -->
                <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_packaging_id']" position="after">
                    <field name="packaging_qty_test" 
                           string="Test Qty" 
                           readonly="1" 
                           groups="product.group_stock_packaging"
                           optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
