<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Estende o formulário de inserção de produto no barcode para adicionar campos de confezioni -->
        <record id="view_stock_move_line_product_selector_confezioni" model="ir.ui.view">
            <field name="name">stock.move.line.product.selector.confezioni</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock_barcode.stock_move_line_product_selector"/>
            <field name="arch" type="xml">
                <!-- Modifica o div quantity para usar flexbox e permitir calculadora à direita -->
                <xpath expr="//div[@name='quantity']" position="attributes">
                    <attribute name="class">d-flex justify-content-between align-items-end my-2</attribute>
                </xpath>
                <!-- Envolve os campos originais (qty_done e product_uom_id) em um container à esquerda -->
                <xpath expr="//div[@name='quantity']/div[@class='col']" position="attributes">
                    <attribute name="class">d-flex align-items-end</attribute>
                </xpath>
                <!-- Adiciona calculadora na mesma linha do campo quantidade/unidade de medida, alinhada à direita -->
                <xpath expr="//div[@name='quantity']" position="inside">
                    <!-- Calcolatrice: valore1, operatore, valore2, risultato - alinhada à direita -->
                    <div name="calcolatrice" class="d-flex align-items-end gap-2">
                        <!-- Valore 1 -->
                        <div class="d-flex flex-column">
                            <div class="text-black-50 mb-1 fs-6">
                                <label for="calcolatrice_valore1" string="Valore 1" class="p-0"/>
                            </div>
                            <field name="calcolatrice_valore1" 
                                   placeholder="0.00"
                                   options="{'type': 'number'}"
                                   class="text-end"
                                   style="width: 80px;"/>
                        </div>
                        <!-- Operatore -->
                        <div class="d-flex align-items-end">
                            <field name="calcolatrice_operatore" 
                                   nolabel="1"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                        <!-- Valore 2 -->
                        <div class="d-flex flex-column">
                            <div class="text-black-50 mb-1 fs-6">
                                <label for="calcolatrice_valore2" string="Valore 2" class="p-0"/>
                            </div>
                            <field name="calcolatrice_valore2" 
                                   placeholder="0.00"
                                   options="{'type': 'number'}"
                                   class="text-end"
                                   style="width: 80px;"/>
                        </div>
                        <!-- Separatore = -->
                        <div class="d-flex align-items-center px-1">
                            <span class="fs-4 fw-bold">=</span>
                        </div>
                        <!-- Risultato -->
                        <div class="d-flex flex-column">
                            <div class="text-black-50 mb-1 fs-6">
                                <label for="calcolatrice_risultato" string="Risultato" class="p-0"/>
                            </div>
                            <field name="calcolatrice_risultato" 
                                   readonly="1"
                                   placeholder="0.00"
                                   class="text-end fw-bold"
                                   options="{'type': 'number'}"
                                   style="width: 80px;"/>
                        </div>
                    </div>
                </xpath>
                <!-- Campos de confezioni ACIMA da linha de quantità (readonly) com labels, centralizados -->
                <xpath expr="//div[@name='quantity']" position="before">
                    <!-- Campos de confezioni em linha com labels, centralizados na página -->
                    <div name="confezioni" class="row my-2 justify-content-center">
                        <!-- Campo Confezioni Richieste (readonly) -->
                        <div class="col-auto" invisible="not move_id or not x_studio_confezioni_richieste">
                            <div class="text-black-50 mt-2 fs-5 text-end">
                                <span class="fa fa-cube me-1"/>
                                <label for="x_studio_confezioni_richieste" string="Confezioni Richieste" class="p-0"/>
                            </div>
                            <field name="x_studio_confezioni_richieste" 
                                   readonly="1"
                                   placeholder="Confezioni Richieste"
                                   class="text-end"
                                   options="{'type': 'number'}"/>
                        </div>
                        <!-- Campo Confezioni (product_packaging_id) - readonly -->
                        <div class="col-auto" invisible="not product_packaging_id">
                            <div class="text-black-50 mt-2 fs-5">
                                <span class="fa fa-archive me-1"/>
                                <label for="product_packaging_id" string="Confezione" class="p-0"/>
                            </div>
                            <field name="product_packaging_id" 
                                   readonly="1"
                                   placeholder="Confezione"
                                   domain="[('product_id', '=', product_id)]"
                                   options="{'no_open': True}"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
