<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Estende il form view del barcode per aggiungere i campi documento fornitore -->
        <record id="stock_picking_barcode_supplier_document" model="ir.ui.view">
            <field name="name">stock.picking.form.barcode.supplier.document</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock_barcode.stock_picking_barcode"/>
            <field name="arch" type="xml">
                <!-- Aggiunge i campi documento fornitore dopo origin, visibili solo per ricezioni -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="supplier_document_number" 
                           string="Num. doc. fornitore"
                           placeholder="Inserire numero documento"
                           invisible="picking_type_code != 'incoming'"
                           readonly="state in ['cancel', 'done']"/>
                    <field name="supplier_document_date" 
                           string="Data doc. fornitore"
                           invisible="picking_type_code != 'incoming'"
                           readonly="state in ['cancel', 'done']"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
