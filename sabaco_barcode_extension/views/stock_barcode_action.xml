<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sovrascrive l'azione del barcode per cambiare il filtro di default -->
        <!-- Default: "Pronto o In attesa" invece di solo "Pronto" -->
        <record id="stock_barcode.stock_picking_action_kanban" model="ir.actions.act_window">
            <field name="name">Operations</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="stock_barcode.stock_picking_view_kanban"/>
            <field name="path">barcode-operations</field>
            <field name="target">fullscreen</field>
            <field name="context">{
                'contact_display': 'partner_address',
                'search_default_ready_or_waiting': 1,
                'search_default_to_do_transfers': 1,
                'order': 'date_done desc, id desc',
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new transfer
                </p><p>
                    Transfers allow you to move products from one location to another.
                </p>
            </field>
        </record>
    </data>
</odoo>
