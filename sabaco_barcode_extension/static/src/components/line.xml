<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Estende o template LineQuantity para adicionar quantidade de embalagem -->
    <t t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
        <!-- Adiciona x_studio_confezioni_richieste (via move_id) e product_packaging_id após a unidade de medida -->
        <xpath expr="//small[@class='o_line_uom text-muted ms-1']" position="after">
            <div class="text-muted small mt-1" t-if="(props.line.move_id &amp;&amp; props.line.move_id.x_studio_confezioni_richieste) or (props.line.product_packaging_id &amp;&amp; props.line.product_packaging_id.name)">
                <span t-if="props.line.move_id &amp;&amp; props.line.move_id.x_studio_confezioni_richieste" t-esc="props.line.move_id.x_studio_confezioni_richieste"/>
                <span t-if="(props.line.move_id &amp;&amp; props.line.move_id.x_studio_confezioni_richieste) and (props.line.product_packaging_id &amp;&amp; props.line.product_packaging_id.name)"> </span>
                <span t-if="props.line.product_packaging_id &amp;&amp; props.line.product_packaging_id.name" t-esc="props.line.product_packaging_id.name"/>
            </div>
        </xpath>
    </t>

    <!-- Oculta o botão de edição (lápis) quando o produto não está disponível -->
    <t t-inherit="stock_barcode.LineUpperButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_edit')]" position="attributes">
            <attribute name="t-if">!displayToggleBtn &amp;&amp; props.line.reserved_uom_qty > 0</attribute>
        </xpath>
    </t>

    <!-- Mostra mensagens de disponibilità e botões de quantidade -->
    <t t-inherit="stock_barcode.LineLowerButtons" t-inherit-mode="extension">
        <!-- Adiciona condição para exibir mensagens de disponibilità -->
        <xpath expr="//div[@t-else='']" position="replace">
            <div t-else="" class="d-flex flex-nowrap gap-2">
                <!-- Caso 1: Non disponibile (reserved_uom_qty === 0) -->
                <t t-if="props.line.reserved_uom_qty === 0">
                    <div class="text-danger fw-bold fs-5">
                        Non disponibile
                    </div>
                </t>
                <!-- Caso 2: Parzialmente disponibile (reserved > 0 ma < demanda totale del move) -->
                <t t-elif="props.line.move_id &amp;&amp; props.line.reserved_uom_qty > 0 &amp;&amp; props.line.reserved_uom_qty &lt; props.line.move_id.product_uom_qty">
                    <div class="d-flex flex-column align-items-end gap-1">
                        <div class="text-warning fw-bold small">
                            Parzialmente disponibile
                        </div>
                        <div class="d-flex flex-nowrap gap-2">
                            <button class="o_line_button btn px-0" style="min-width:0"/>
                            <button t-if="isSelected &amp;&amp; env.model.toggleAsCounted" t-on-click="toggleAsCounted"
                                    t-attf-class="o_line_button btn btn-{{quantityIsSet ? 'warning o_unset' : 'danger o_count_zero'}}">
                                <span t-if="quantityIsSet" class="fa fa-lg fa-question"/>
                                <span t-else="">0</span>
                            </button>
                            <button t-if="isSelected &amp;&amp; qtyDone" name="decrementButton"
                                    class="o_line_button o_remove_unit btn btn-light"
                                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                                    t-on-click="() => this.addQuantity(-1)">
                                -1
                            </button>
                            <button t-if="displayIncrementButton" name="incrementButton"
                                    class="o_line_button o_add_quantity btn btn-light"
                                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                                    t-on-click="() => this.addQuantity(1)">+1</button>
                            <button t-if="displayFulfillbutton" name="fulfillButton"
                                    t-on-click="() => this.addQuantity(incrementQty)"
                                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                                    t-attf-class="o_line_button o_add_remaining_quantity btn btn-{{isSelected ? 'light' : 'secondary'}}">
                                <t t-if="incrementQty > 0">+</t><t t-esc="incrementQty"/>
                            </button>
                            <button t-if="displayDeleteButton" name="deleteButton"
                                    t-on-click="() => this.env.model.deleteLine(line)"
                                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                                    class="o_line_button o_delete_line btn btn-danger">
                                <span class="fa fa-lg fa-trash"/>
                            </button>
                        </div>
                    </div>
                </t>
                <!-- Caso 3: Totalmente disponibile (reserved >= demanda) - botões normais -->
                <t t-else="">
                    <button class="o_line_button btn px-0" style="min-width:0"/>
                    <button t-if="isSelected &amp;&amp; env.model.toggleAsCounted" t-on-click="toggleAsCounted"
                            t-attf-class="o_line_button btn btn-{{quantityIsSet ? 'warning o_unset' : 'danger o_count_zero'}}">
                        <span t-if="quantityIsSet" class="fa fa-lg fa-question"/>
                        <span t-else="">0</span>
                    </button>
                    <button t-if="isSelected &amp;&amp; qtyDone" name="decrementButton"
                            class="o_line_button o_remove_unit btn btn-light"
                            t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                            t-on-click="() => this.addQuantity(-1)">
                        -1
                    </button>
                    <button t-if="displayIncrementButton" name="incrementButton"
                            class="o_line_button o_add_quantity btn btn-light"
                            t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                            t-on-click="() => this.addQuantity(1)">+1</button>
                    <button t-if="displayFulfillbutton" name="fulfillButton"
                            t-on-click="() => this.addQuantity(incrementQty)"
                            t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                            t-attf-class="o_line_button o_add_remaining_quantity btn btn-{{isSelected ? 'light' : 'secondary'}}">
                        <t t-if="incrementQty > 0">+</t><t t-esc="incrementQty"/>
                    </button>
                    <button t-if="displayDeleteButton" name="deleteButton"
                            t-on-click="() => this.env.model.deleteLine(line)"
                            t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                            class="o_line_button o_delete_line btn btn-danger">
                        <span class="fa fa-lg fa-trash"/>
                    </button>
                </t>
            </div>
        </xpath>
    </t>

</templates>
