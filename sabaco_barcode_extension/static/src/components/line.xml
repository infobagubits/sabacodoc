<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Estende o template LineQuantity para adicionar quantidade de embalagem -->
    <t t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
        <!-- Adiciona quantidade de embalagem após a unidade de medida -->
        <xpath expr="//small[@class='o_line_uom text-muted ms-1']" position="after">
            <div class="text-muted small mt-1" t-if="props.line.product_packaging_id and props.line.product_packaging_uom_qty">
                <span class="fw-bold">Confezioni:</span> 
                <span t-esc="props.line.product_packaging_uom_qty.toFixed(2)"/>
            </div>
        </xpath>
    </t>

</templates>
