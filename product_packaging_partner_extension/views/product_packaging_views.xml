<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_packaging_form_view_inherit" model="ir.ui.view">
        <field name="name">product.packaging.form.inherit</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Cliente/Fornitore" name="contacts">
                        <field name="contact_line_ids">
                            <list editable="bottom">
                                <field name="partner_id"/>
                                <field name="partner_type" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    
    <!-- Herda a view do Studio para adicionar coluna de parceiros -->
    <record id="product_template_studio_packaging_inherit_partners" model="ir.ui.view">
        <field name="name">product.template.studio.packaging.inherit.partners</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="studio_customization.odoo_studio_product__eec7a712-35d6-4c6c-a0d0-78b695096804"/>
        <field name="arch" type="xml">
            <!-- Adiciona coluna de parceiros após company_id na lista do Studio -->
            <xpath expr="//field[@name='packaging_ids']/list/field[@name='company_id']" position="after">
                <field name="linked_partner_ids" 
                       widget="many2many_tags" 
                       string="Parceiros Vinculados"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo> 