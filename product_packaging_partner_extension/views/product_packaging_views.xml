<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_packaging_form_view_inherit" model="ir.ui.view">
        <field name="name">product.packaging.form.inherit</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Cliente/Fornitore" name="contacts">
                        <field name="contact_line_ids">
                            <list editable="bottom">
                                <field name="partner_id"/>
                                <field name="partner_type" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo> 