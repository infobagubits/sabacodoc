<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modifica il testo del campo expiration_time -->
    <record id="product_template_form_view_expiry_text" model="ir.ui.view">
        <field name="name">product.template.form.expiry.text</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Modifica il testo da "giorni che seguono la ricezione" a "giorni che seguono la produzione" -->
            <xpath expr="//field[@name='expiration_time']" position="attributes">
                <attribute name="string">Giorni che seguono la produzione</attribute>
                <attribute name="help">giorni che seguono la produzione</attribute>
            </xpath>
        </field>
    </record>
</odoo>
