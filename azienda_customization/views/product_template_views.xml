<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modifica il testo informativo "days after receipt" in "giorni che seguono la produzione" -->
    <record id="product_template_form_view_expiry_text" model="ir.ui.view">
        <field name="name">product.template.form.expiry.text</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_expiry.view_product_form_expiry"/>
        <field name="arch" type="xml">
            <!-- Sostituisce direttamente il div che contiene il campo e il testo -->
            <xpath expr="//label[@for='expiration_time']/following-sibling::div[1]" position="replace">
                <div>
                    <field name="expiration_time" class="oe_inline"/>
                    <span> giorni che seguono la produzione</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Nasconde campo standard_price (Costo) -->
    <record id="product_template_form_view_hide_standard_price" model="ir.ui.view">
        <field name="name">product.template.form.hide.standard.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Nasconde label del standard_price -->
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Nasconde div del standard_price -->
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Nasconde campo sale_delay (Tempo di risposta al cliente) -->
    <record id="product_template_form_view_hide_sale_delay" model="ir.ui.view">
        <field name="name">product.template.form.hide.sale.delay</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <!-- Nasconde label del sale_delay -->
            <xpath expr="//label[@for='sale_delay']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Nasconde div del sale_delay -->
            <xpath expr="//label[@for='sale_delay']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Nasconde campo removal_time (Data di rimozione) -->
    <record id="product_template_form_view_hide_removal_time" model="ir.ui.view">
        <field name="name">product.template.form.hide.removal.time</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_expiry.view_product_form_expiry"/>
        <field name="arch" type="xml">
            <!-- Nasconde label del removal_time -->
            <xpath expr="//label[@for='removal_time']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Nasconde div del removal_time -->
            <xpath expr="//label[@for='removal_time']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Modifica label "Consumabile" in "Prodotto" nel campo type -->
    <record id="product_template_form_view_change_type_label" model="ir.ui.view">
        <field name="name">product.template.form.change.type.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Sostituisce il campo type con le nuove opzioni -->
            <xpath expr="//field[@name='type']" position="replace">
                <field name="type" widget="radio" options="{'horizontal': true}"/>
            </xpath>
        </field>
    </record>
</odoo>
